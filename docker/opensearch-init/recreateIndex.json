{
  "settings": {
    "analysis": {
      "filter": {
        "autocomplete_filter": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 20
        },
        "synonym_filter": {
          "type": "synonym",
          "synonyms": [
            "bug, defect, issue",
            "function, method",
            "variable, var",
            "loop, iteration, for loop, while loop",
            "object, instance",
            "error, exception, fault",
            "parameter, argument, param",
            " version control, git",
            "repository, repo",
            "deploy, release",
            "continuous integration, ci",
            "continuous deployment, cd",
            "js, javascript",
            "py, python",
            "ts, typescript",
            "csharp, c#, dotnet",
            "cpp, c++",
            "react, reactjs",
            "node, nodejs",
            "nosql, non-relational database",
            "row, record",
            "column, field",
            "index, key",
            "ui, user interface, gui",
            "ux, user experience",
            "web app, website, application",
            "frontend, client-side",
            "backend, server-side",
            "api, rest api, endpoint, rest",
            "authentication, login, auth",
            "authorization, permissions, access control, access",
            "encryption, encoding, hashing"
          ]
        }
      },
      "analyzer": {
        "autocomplete_index": {
          "tokenizer": "standard",
          "filter": ["lowercase", "autocomplete_filter"]
        },
        "autocomplete_search": {
          "tokenizer": "standard",
          "filter": ["lowercase"]
        },
        "custom_synonym_analyzer": {
          "tokenizer": "standard",
          "filter": ["lowercase", "synonym_filter"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "title": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword"
          },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_index",
            "search_analyzer": "autocomplete_search"
          },
          "synonyms": {
            "type": "text",
            "analyzer": "custom_synonym_analyzer"
          }
        }
      },
      "content_raw": {
        "type": "text",
        "fields": {
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_index",
            "search_analyzer": "autocomplete_search"
          },
          "synonyms": {
            "type": "text",
            "analyzer": "custom_synonym_analyzer"
          }
        }
      },
      "content_html": {
        "type": "text"
      },
      "commandList": {
        "type": "keyword"
      },
      "tags": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "createdAt": {
        "type": "long"
      },
      "updatedAt": {
        "type": "long"
      },
      "id": {
        "type": "long"
      }
    }
  }
}
